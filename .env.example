# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/taskflow

# Secret for signing JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Base URL for API calls. Leave empty in development (uses relative URLs).
# On Vercel, set to your deployment URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_API_URL=

# API Ninjas key for the inspirational quotes on the dashboard
# https://api-ninjas.com/ (server-side only, never exposed to the browser)
QUOTES_API_KEY=

# Password reset delivery.
# No email service is wired up, so by default /api/auth/forgot-password does NOT
# return the one-time token — handing it back in the response would let anyone
# request a reset for any registered address and take over that account.
# Set this to "true" ONLY for local/manual testing, where you need to copy the
# token out of the page. Never enable it on a public deployment.
TASKFLOW_EXPOSE_RESET_TOKEN=false
